# ── Config del publicador Dusa ──
# Copia este archivo a ".env" (sin .example) y llena los valores.
# ⚠️ El archivo .env NUNCA se sube a git (ya está en .gitignore). NO lo compartas.

# Token de acceso con permiso instagram_content_publish (largo, dura 60 días).
ACCESS_TOKEN=

# ID de tu cuenta de Instagram Business. Descúbrelo con:  node publish.mjs --whoami
IG_USER_ID=

# (Opcional) Para publicar también en Facebook:
FB_PAGE_ID=
# Si tu token de página es distinto al de arriba, ponlo aquí (si no, se usa ACCESS_TOKEN):
FB_PAGE_TOKEN=
